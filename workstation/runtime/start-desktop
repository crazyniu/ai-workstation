#!/bin/sh
set -eu
export HOME=/home/dev DISPLAY=:1 XDG_RUNTIME_DIR=/tmp/runtime-dev
export LIBGL_ALWAYS_SOFTWARE=1
# Scope the glycin container fallback to desktop bwrap children; Chrome keeps its sandbox.
export PATH="/usr/local/libexec/workstation-glycin:$PATH"
install -d -m 700 "$XDG_RUNTIME_DIR"
for i in $(seq 1 100); do [ -S /tmp/.X11-unix/X1 ] && break; sleep 0.2; done
[ -S /tmp/.X11-unix/X1 ] || { echo 'VNC X11 display :1 did not become ready' >&2; exit 1; }
cd /home/dev
exec setpriv --no-new-privs dbus-run-session -- xfce4-session
