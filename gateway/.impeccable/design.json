  "narrative": {
    "northStar": "蓝色海岸上的轻量 NAS 桌面",
    "overview": "蓝色海岸壁纸承托图标与名称，白色设置窗口保留熟悉的桌面秩序。彩色图标采用同一浅色圆角底板；主要操作使用清晰的蓝色按钮，内容与设置停留在二级界面。\n\n桌面保持轻量、疏朗，管理表单采用紧凑而有留白的布局。深色模式通过同一组语义变量切换窗口、表单、编辑器与菜单的表面和文字；自动模式跟随系统偏好，保持同一布局与图标比例。",
    "keyCharacteristics": [
      "蓝色自然摄影壁纸与白色浮动窗口。",
      "统一彩色应用图标和纯图标选择网格。",
      "设置分层、文件上传优先、手机端完整设置页面。",
      "亮色、暗色和跟随系统的自动模式。"
    ],
    "rules": [
      {
        "name": "The Single Accent Rule",
        "body": "操作强调使用蓝色；彩色应用图标和壁纸承担其余颜色，避免为设置模块各造一套颜色。",
        "section": "colors"
      }
    ],
    "dos": [
      "沿用已有的蓝色海岸桌面、统一图标底板和窗口层级。",
      "所有应用图标保持正方形并使用 object-fit: contain。",
      "图标选择区只显示图形，通过 title 和 aria-label 提供名称。",
      "将配置、服务升级、备份和账户操作放在设置的二级页面。",
      "手机端保留至少 44px 的常用操作触摸区域，并遵循减少动态效果偏好。"
    ],
    "donts": [
      "不要恢复系统默认下拉框或混用不同风格的应用图标。",
      "不要在纯图标选择区增加逐项文字、文件路径或卡片说明。",
      "不要拉伸图标或用大号线条菜单图形替代彩色应用底板。",
      "不要把管理表单、长说明和全部服务状态堆到桌面首页。",
      "不要把截图或浏览器检查当作真实手机硬件验收。"
    ]
  }
}
