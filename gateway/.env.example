# Choose an unused address outside the router's DHCP range.
GATEWAY_LAN_ADDRESS=192.168.10.2/24
GATEWAY_LAN_ROUTER=192.168.10.1
GATEWAY_PARENT_INTERFACE=eth0
# Optional: NAS host LAN address. Traffic to it uses the control bridge.
GATEWAY_HOST_ADDRESS=
GATEWAY_BRIDGE_ROUTER=172.30.100.1

# Keep these three control bridge values in the same unused subnet.
GATEWAY_CONTROL_SUBNET=172.30.100.0/24
GATEWAY_CONTROL_ADDRESS=172.30.100.2
GATEWAY_IMAGE=gateway-local:1.0.0
# Optional official base registry override for building only.
GATEWAY_BASE_IMAGE=ubuntu:24.04

# Web password is used only when initializing a fresh container.
GATEWAY_ADMIN_PASSWORD=admin
# SSH account/password are applied when the container starts.
GATEWAY_CONTAINER_USER=admin
GATEWAY_CONTAINER_PASSWORD=admin
