# Native Linux services. Keep the private copy outside Git, mode 600.
# Existing host root credentials remain unchanged.
DEV_PASSWORD=root
VNC_PASSWORD=root
VNC_AUTH=password
NOVNC_TLS=1
WORKSTATION_COUNTRY=SG
WORKSTATION_LANGUAGE=en
WORKSTATION_TIMEZONE=Asia/Singapore
GATEWAY_ADMIN_PASSWORD=root
GATEWAY_CONTAINER_USER=root
# Used only for a newly created non-root gateway account; host root is preserved.
GATEWAY_CONTAINER_PASSWORD=root
