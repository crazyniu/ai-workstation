FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates curl
COPY install-native.py /source/install-native.py
COPY gateway/ /source/gateway/
COPY workstation/ /source/workstation/
COPY native/native.env.example /source/native/native.env.example
RUN chmod 600 /source/native/native.env.example \
    && cp /etc/shadow /tmp/shadow.before \
    && python3 /source/install-native.py --role all --config /source/native/native.env.example --apply --no-start \
    && test "$(sed -n '/^root:/p' /tmp/shadow.before)" = "$(sed -n '/^root:/p' /etc/shadow)" \
    && rm /tmp/shadow.before
COPY tests/native-smoke-start.sh /usr/local/bin/native-smoke-start
ENTRYPOINT ["/bin/bash", "/usr/local/bin/native-smoke-start"]
